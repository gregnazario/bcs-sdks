    "i64": {
      "valid": [
        {"name": "zero", "value": "0", "bcs_hex": "0000000000000000"},
        {"name": "one", "value": "1", "bcs_hex": "0100000000000000"},
        {"name": "minus_one", "value": "-1", "bcs_hex": "ffffffffffffffff"},
        {"name": "max", "value": "9223372036854775807", "bcs_hex": "ffffffffffffff7f"},
        {"name": "min", "value": "-9223372036854775808", "bcs_hex": "0000000000000080"}
