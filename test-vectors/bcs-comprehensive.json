{
  "version": "1.0.0",
  "description": "Comprehensive BCS test vectors for multi-language SDK validation",
  "spec_version": "1.0.0",

  "primitives": {
    "bool": {
      "valid": [
        {"name": "false", "value": false, "bcs_hex": "00"},
        {"name": "true", "value": true, "bcs_hex": "01"}
      ],
      "invalid": [
        {"name": "invalid_0x02", "bcs_hex": "02", "error": "InvalidBoolean"},
        {"name": "invalid_0xff", "bcs_hex": "ff", "error": "InvalidBoolean"},
        {"name": "empty", "bcs_hex": "", "error": "UnexpectedEof"}
      ]
    },

    "u8": {
      "valid": [
        {"name": "zero", "value": 0, "bcs_hex": "00"},
        {"name": "one", "value": 1, "bcs_hex": "01"},
